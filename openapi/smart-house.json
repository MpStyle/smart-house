{
  "openapi": "3.0.4",
  "info": {
    "title": "Smart House API",
    "version": "v1"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "SmartHouse.Api"
        ],
        "operationId": "Health",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/session": {
      "get": {
        "tags": [
          "SmartHouse.Api"
        ],
        "operationId": "Session",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "get": {
        "tags": [
          "SmartHouse.Api"
        ],
        "description": "Navigate the browser here to start Netatmo OAuth. The provider returns to /api/v1/auth/callback.",
        "operationId": "Login",
        "responses": {
          "302": {
            "description": "Found"
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "SmartHouse.Api"
        ],
        "operationId": "Logout",
        "parameters": [
          {
            "name": "X-CSRF-TOKEN",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/demo": {
      "post": {
        "tags": [
          "SmartHouse.Api"
        ],
        "description": "Create a demo session. Available only when Development demo mode is enabled.",
        "operationId": "Demo",
        "parameters": [
          {
            "name": "X-CSRF-TOKEN",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/v1/homes": {
      "get": {
        "tags": [
          "SmartHouse.Api"
        ],
        "operationId": "Homes",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HomesResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/homes/{homeId}/measurements": {
      "get": {
        "tags": [
          "SmartHouse.Api"
        ],
        "operationId": "Snapshot",
        "parameters": [
          {
            "name": "homeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SnapshotResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/homes/{homeId}/history/{measurementId}": {
      "get": {
        "tags": [
          "SmartHouse.Api"
        ],
        "operationId": "History",
        "parameters": [
          {
            "name": "homeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "measurementId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hours",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/History"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiError": {
        "required": [
          "code"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          }
        },
        "description": "Exposes a safe, machine-readable API failure code."
      },
      "HealthResponse": {
        "required": [
          "status"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          }
        },
        "description": "Reports process readiness."
      },
      "History": {
        "required": [
          "measurementId",
          "unit",
          "from",
          "to",
          "points"
        ],
        "type": "object",
        "properties": {
          "measurementId": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "from": {
            "type": "string",
            "format": "date-time"
          },
          "to": {
            "type": "string",
            "format": "date-time"
          },
          "points": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HistoryPoint"
            }
          }
        },
        "description": "Contains a measurement's history within explicit bounds and units."
      },
      "HistoryPoint": {
        "required": [
          "time",
          "value"
        ],
        "type": "object",
        "properties": {
          "time": {
            "type": "string",
            "format": "date-time"
          },
          "value": {
            "type": "number",
            "format": "double",
            "nullable": true
          }
        },
        "description": "Represents a timestamped history sample, including a possible gap."
      },
      "HomeResponse": {
        "required": [
          "id",
          "name",
          "timezone"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          }
        },
        "description": "Describes an authorized home without internal provider identifiers."
      },
      "HomesResponse": {
        "required": [
          "homes",
          "warnings",
          "accountName"
        ],
        "type": "object",
        "properties": {
          "homes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HomeResponse"
            }
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "accountName": {
            "type": "string",
            "nullable": true
          }
        },
        "description": "Lists authorized homes, discovery warnings, and the account display identity."
      },
      "MeasurementResponse": {
        "required": [
          "id",
          "kind",
          "deviceName",
          "value",
          "unit",
          "measuredAt",
          "hasHistory",
          "updateFailed",
          "status",
          "sampleMinutes"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "deviceName": {
            "type": "string"
          },
          "value": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "unit": {
            "type": "string"
          },
          "measuredAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "hasHistory": {
            "type": "boolean"
          },
          "updateFailed": {
            "type": "boolean"
          },
          "status": {
            "$ref": "#/components/schemas/MeasurementStatus"
          },
          "sampleMinutes": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          }
        },
        "description": "Returns a reading's value, units, provenance, and availability without internal history sources."
      },
      "MeasurementStatus": {
        "enum": [
          "fresh",
          "stale",
          "unavailable"
        ],
        "type": "string"
      },
      "RoomResponse": {
        "required": [
          "id",
          "name",
          "measurements"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "measurements": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MeasurementResponse"
            }
          }
        },
        "description": "Groups API readings by room."
      },
      "SessionResponse": {
        "required": [
          "authenticated",
          "csrfToken",
          "authAvailable",
          "demoAvailable",
          "demo",
          "expiresAt"
        ],
        "type": "object",
        "properties": {
          "authenticated": {
            "type": "boolean"
          },
          "csrfToken": {
            "type": "string"
          },
          "authAvailable": {
            "type": "boolean"
          },
          "demoAvailable": {
            "type": "boolean"
          },
          "demo": {
            "type": "boolean"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "description": "Reports browser session state without exposing provider credentials."
      },
      "SnapshotResponse": {
        "required": [
          "homeId",
          "timezone",
          "fetchedAt",
          "rooms",
          "warnings"
        ],
        "type": "object",
        "properties": {
          "homeId": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          },
          "fetchedAt": {
            "type": "string",
            "format": "date-time"
          },
          "rooms": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RoomResponse"
            }
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "description": "Returns a home's timestamped readings and update warnings."
      }
    }
  },
  "tags": [
    {
      "name": "SmartHouse.Api"
    }
  ]
}